# ==========================================================
# TGC Connect - Enterprise Web Server & Security Configuration
# Compatible with Hostinger, Apache 2.4+, LiteSpeed, OpenLiteSpeed
# ==========================================================

# 1. Disable Directory Indexing/Browsing
Options -Indexes

# 2. Block Public HTTP Access to Sensitive Files & Documentation
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|md|git.*)|schema\.sql|CLAUDE\.md|AGENTS\.md|README\.md|config\.php|setup_mysql\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Optional: Force HTTPS (Enable if SSL is active on Hostinger)
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
